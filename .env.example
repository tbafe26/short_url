# 변수 이름만 둔다. 실제 값은 .env(저장소 제외)나 배포 환경에 넣는다.
# 로컬 테스트 DB 예: postgres://postgres:postgres@localhost:5432/short_url

# 백엔드: Postgres 접속 주소 (`cargo test`의 DB 통합 테스트에도 필요)
DATABASE_URL=
# 백엔드: 서비스 공개 주소. 단축 주소의 기준이 된다 (예: 로컬은 http://localhost:8080)
PUBLIC_BASE_URL=
# 백엔드: 바인드 주소와 포트 (Dioxus 서버가 읽는다. Railway는 PORT를 주입한다)
IP=
PORT=

# Cloudflare Worker: Railway 백엔드 공개 주소 (wrangler.jsonc의 vars 또는 `--var BACKEND_ORIGIN:...`로 지정)
BACKEND_ORIGIN=
