// Cloudflare Worker: 서비스의 유일한 공개 접점 (ADR-0001)
// - 웹 화면: Dioxus 웹 번들을 Static Assets로 제공한다
// - `/api/*`와 숫자 경로(`/123`): Railway 백엔드로 프록시한다 (src/worker.js)
// 비밀 값은 넣지 않는다. BACKEND_ORIGIN은 공개 주소라 비밀이 아니다.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "short-url",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // `dx build --release`의 웹 번들 출력 위치 (이 파일 기준 상대 경로)
    "directory": "../target/dx/short_url/release/web/public",
    "binding": "ASSETS"
    // not_found_handling을 SPA로 두지 않는다. 그러면 브라우저에서 연 `/123`이
    // Worker 스크립트를 거치지 않고 index.html로 응답되기 때문이다.
  },
  "vars": {
    // Railway 백엔드 공개 주소 (끝에 `/` 없이). 실제 주소는 저장소에 두지 않는다.
    // 배포할 때 `npx wrangler deploy --var BACKEND_ORIGIN:https://...`로 덮어쓴다.
    "BACKEND_ORIGIN": "https://replace-with-railway-backend.invalid"
  }
}
